# CyberTrace Environment Configuration Template
# Copy this file to .env for local customization

CYBERTRACE_ENV=development
LOG_LEVEL=INFO

# Overpass API (OpenStreetMap) Endpoint
OVERPASS_API_URL=https://overpass-api.de/api/interpreter
OVERPASS_TIMEOUT_SECONDS=25
OVERPASS_CACHE_TTL_HOURS=168

# Streamlit App Settings
STREAMLIT_SERVER_PORT=8501
STREAMLIT_SERVER_HEADLESS=true

# Official Reporting Helplines
CYBERCRIME_PORTAL_URL=https://www.cybercrime.gov.in/
FINANCIAL_FRAUD_HELPLINE=1930
